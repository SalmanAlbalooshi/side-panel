{
  "manifest_version": 3,
  "name": "Side Panel link",
  "version": "1.1.0",
  "description": "Shows on your Side Panel when Claude, ChatGPT or Gemini is writing or has finished. Sends only the tab title and state, never your chats.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:47822/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Side Panel link" },
  "content_scripts": [
    { "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://gemini.google.com/*"], "js": ["watch.js"], "run_at": "document_idle" }
  ]
}
